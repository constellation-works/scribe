-p
--safe-mode
--tools

--model
claude-haiku-5-5
--output-format
json
--json-schema
{"type":"object","properties":{"title":{"type":"string","description":"one line naming what the session was about"},"summary":{"type":"string","description":"what happened in the session; aim for at most 900 characters, hard limit 1200"},"goals":{"type":"string","description":"what the user set out to do"},"next":{"type":"array","items":{"type":"string"},"description":"open next steps, one per item; aim for at most 750 characters in all, hard limit 1000, counting a '- ' prefix per item and a newline between items"},"topics":{"type":"array","items":{"type":"string"},"description":"0-5 lowercase kebab-case labels, reusing existing ones first"},"related":{"type":"array","items":{"type":"string"},"description":"references the session mentions: task:<id>, pr:<owner>/<repo>#<n>, repo:<slug> or session:<id>"},"terms":{"type":"array","items":{"type":"object","properties":{"term":{"type":"string","description":"the phrase the user coined or defined"},"said":{"type":"string","description":"the user's own words that define or first use it, copied character for character"},"message":{"type":"string","description":"the id of the user message those words are in"}},"required":["term","said","message"],"additionalProperties":false}},"open":{"description":"rewrite the existing open segment; omitted or null keeps its content; without an existing open segment, an object starts a new segment at the first window message","anyOf":[{"type":"object","properties":{"heading":{"type":"string"},"text":{"type":"string"},"topics":{"type":"array","items":{"type":"string"}},"related":{"type":"array","items":{"type":"string"}}},"required":["heading","text","topics","related"],"additionalProperties":false},{"type":"null"}]},"new":{"type":"array","items":{"type":"object","properties":{"heading":{"type":"string"},"text":{"type":"string"},"topics":{"type":"array","items":{"type":"string"}},"related":{"type":"array","items":{"type":"string"}},"starts_at":{"type":"string"}},"required":["heading","text","topics","related","starts_at"],"additionalProperties":false}}},"required":["title","summary","goals","next","topics","related","terms","new"],"additionalProperties":false}
