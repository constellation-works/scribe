{
  "description": "scribe: record #scribe lines and switch /scribe on and off from typed prompts, fill cites and mark session passes due after each reply, and mark the final pass due at session end",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "scribe hook user-prompt-submit",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "scribe hook stop",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "scribe hook session-end",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
