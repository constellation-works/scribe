{
  "description": "scribe Codex lifecycle integration; review and trust these hooks before recording.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$PLUGIN_ROOT/bin/scribe-hook\" session-start",
            "timeout": 3
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$PLUGIN_ROOT/bin/scribe-hook\" user-prompt-submit",
            "timeout": 180
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$PLUGIN_ROOT/bin/scribe-hook\" stop",
            "timeout": 180
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$PLUGIN_ROOT/bin/scribe-hook\" session-end",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
