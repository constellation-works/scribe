{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The same payload `scribe question ask --json` prints (docs/design/scribe/specs/output-contract.md). entry and session are the shapes of `entry show --json` and `session show --json`.",
  "type": "object",
  "required": ["status", "answer", "claims", "conflicts", "evidence_considered", "dropped_quotes", "hidden_matches", "lookup", "records", "warnings"],
  "properties": {
    "status": { "enum": ["answered", "no_record", "conflict", "record"] },
    "answer": { "type": "string" },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["text", "quote", "cite"],
        "properties": {
          "text": { "type": "string" },
          "quote": { "type": "string", "description": "Verbatim from the cited record." },
          "cite": { "type": "string", "description": "An entry id, session:<id> or task:<id>." }
        }
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["cites", "note"],
        "properties": {
          "cites": { "type": "array", "items": { "type": "string" }, "minItems": 2 },
          "note": { "type": "string" }
        }
      }
    },
    "evidence_considered": { "type": "integer", "minimum": 0 },
    "dropped_quotes": { "type": "integer", "minimum": 0 },
    "hidden_matches": { "type": "integer", "minimum": 0 },
    "lookup": {
      "enum": [null, "last_session", "named_session", "next_steps", "tag_period", "term", "orchestrator_session"]
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "cite", "entry", "session", "task", "terms"],
        "properties": {
          "kind": { "enum": ["entry", "session", "task"] },
          "cite": { "type": "string" },
          "entry": { "type": ["object", "null"] },
          "session": { "type": ["object", "null"] },
          "task": {
            "type": ["object", "null"],
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "status": { "type": "string" },
              "tags": { "type": "array", "items": { "type": "string" } },
              "updated": { "type": ["string", "null"] },
              "execution_summary": { "type": "string" }
            }
          },
          "terms": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["term", "said", "message"],
              "properties": {
                "term": { "type": "string" },
                "said": { "type": "string" },
                "message": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "code", "error"],
        "properties": {
          "path": { "type": "string" },
          "code": { "type": "string" },
          "error": { "type": "string" }
        }
      }
    }
  }
}
